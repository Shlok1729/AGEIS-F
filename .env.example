# ─── Aegis-F Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git — it is in .gitignore.

# ── Network ──────────────────────────────────────────────────────────────────

# Coston2 RPC endpoint (public — no API key required for testnet)
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Flare Mainnet RPC (for read-only Kinetic position queries)
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc

# ── Deployment / Signing ─────────────────────────────────────────────────────

# Your EOA private key (with 0x prefix).
# Must hold Coston2 FLR (free from https://faucet.flare.network, select Coston2).
# ⚠ Never commit this value. This key is the deployer AND the demo PMW wallet.
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# ── TEE Keeper Daemon ────────────────────────────────────────────────────────

# FCC extension mode:
#   0 = Local simulation (default — works without hardware TEE)
#   1 = Hardware attestation (requires GCP Confidential Space)
MODE=0

# HTTP port for the tee-proxy API (frontend polls this)
PORT=6662

# Internal port for FCC extension communication
INTERNAL_PORT=6661

# ── Contract Addresses (populated by deploy.cjs) ─────────────────────────────
# These are set automatically when you run:
#   npx hardhat run scripts/deploy.cjs --network coston2
#
# Or fill in manually after deployment:
POSITION_CONTRACT=
VAULT_CONTRACT=
SENDER_CONTRACT=

# ── Optional ─────────────────────────────────────────────────────────────────

# API key for rate-limiting the tee-proxy endpoints (optional — leave blank for open access)
API_KEY=

# Block explorer base URL (used in frontend for tx deep-links)
EXPLORER_URL=https://coston2-explorer.flare.network
